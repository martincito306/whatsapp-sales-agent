PORT=3000

# Seguridad del Panel Administrativo (Obligatorio - Fail-Closed)
ADMIN_KEY=cambia_esta_clave_secreta_de_administrador

# Base de Datos PostgreSQL / Supabase (Pooler IPv4)
DATABASE_URL=postgresql://postgres.tu_proyecto:tu_password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_SECRET_KEY=tu_service_role_secret_key

# Inteligencia Artificial (Google Gemini API)
GEMINI_API_KEY=tu_api_key_de_gemini

# WhatsApp Cloud API Oficial (Meta for Developers)
WHATSAPP_TOKEN=tu_access_token_de_meta
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=tu_verify_token_personalizado
WHATSAPP_APP_SECRET=tu_app_secret_para_validar_x_hub_signature_256

# Notificaciones al Administrador
ADMIN_PHONE=573000000000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auditoría Estática de Secretos (patrones adicionales separados por coma)
FORBIDDEN_PATTERNS=
